{
  "name": "intern-notifs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal internship notification and tracking foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir test --exclude ingestion-resource-budget.test.ts",
    "test:budget": "NODE_OPTIONS=--expose-gc vitest run --dir test test/ingestion-resource-budget.test.ts",
    "test:unit": "vitest run --dir test --exclude test/integration.workflow.test.ts --exclude test/api.workflow.test.ts --exclude test/full-day.workflow.test.ts",
    "test:integration": "vitest run test/destination-queue-resilience.integration.test.ts test/full-day.workflow.test.ts",
    "test:e2e": "npm run build:cloudflare && node --test test/e2e/*.e2e.mjs",
    "test:greenhouse:live": "GREENHOUSE_LIVE=1 vitest run test/greenhouse.live.test.ts",
    "test:watch": "vitest",
    "audit:employers": "tsx scripts/audit-employer-classification.ts",
    "audit:browser-companion": "tsx scripts/audit-browser-companion.ts",
    "source:quality": "tsx scripts/source-quality.ts",
    "source:trusted-community:dry-run": "tsx scripts/trusted-community-dry-run.ts",
    "probes:trusted-catalog": "tsx scripts/trusted-catalog-probes.ts",
    "probes:random-official": "tsx scripts/random-official-probes.ts",
    "coverage:companies": "tsx scripts/company-coverage.ts",
    "greenhouse:manifest": "tsx scripts/greenhouse-manifest.ts",
    "discover:lever": "tsx scripts/discover-lever.ts",
    "lever:ledger": "tsx scripts/lever-ledger.ts",
    "lever:manifest": "tsx scripts/lever-manifest.ts",
    "lever:probe": "tsx scripts/lever-probe.ts",
    "lever:reverify": "tsx scripts/lever-reverify.ts",
    "ashby:ledger": "tsx scripts/ashby-ledger.ts",
    "ashby:probe": "tsx scripts/ashby-probe.ts",
    "ashby:manifest": "tsx scripts/ashby-manifest.ts",
    "ashby:reverify": "tsx scripts/ashby-reverify.ts",
    "test:lever:live": "LEVER_LIVE=1 vitest run test/lever.live.test.ts",
    "test:ashby:live": "ASHBY_LIVE=1 vitest run test/ashby.live.test.ts",
    "test:openai:live": "OPENAI_LIVE=1 vitest run test/openai-shadow-inference.live.test.ts",
    "discover:firecrawl": "tsx scripts/firecrawl-discovery.ts",
    "migrate:open-index": "tsx src/migrate-open-index.ts",
    "migrate:catalog-recency": "tsx src/migrate-catalog-recency.ts",
    "audit:catalog-index": "tsx src/migrate-open-index.ts",
    "notifications:log": "tsx scripts/notification-log.ts",
    "dlq": "tsx scripts/dlq-operations.ts",
    "migrate:catalog-search": "tsx src/migrate-catalog-search.ts",
    "migrate:source-occurrences": "tsx src/migrate-source-occurrences.ts",
    "migrate:posting-identity": "tsx scripts/posting-identity-repair.ts",
    "audit:posting-identity": "tsx scripts/posting-identity-repair.ts --audit --gate",
    "migrate:catalog-quality": "tsx scripts/catalog-quality-backfill.ts",
    "migrate:role-metadata": "tsx scripts/role-metadata-backfill.ts",
    "eval:shadow:offline": "tsx scripts/shadow-extraction-eval.ts --offline test/fixtures/shadow-extraction-recorded.json --report eval/shadow-extraction-results",
    "eval:shadow:live": "tsx scripts/shadow-extraction-eval.ts --live --report eval/shadow-extraction-results",
    "build:browser-companion": "esbuild browser-companion/content.ts --bundle --format=iife --platform=browser --outfile=browser-companion/dist/content.js",
    "build:cloudflare": "npm run build:cloudflare:api && npm run build:cloudflare:ingestion",
    "build:cloudflare:api": "wrangler deploy --config wrangler.api.jsonc --dry-run --outdir cloudflare/dist/api",
    "build:cloudflare:ingestion": "wrangler deploy --config wrangler.ingestion.jsonc --dry-run --outdir cloudflare/dist/ingestion",
    "build:web": "npm --prefix mobile run web:export",
    "build:icons": "node mobile/scripts/generate-icons.mjs",
    "serve:web": "wrangler pages dev mobile/dist --port 4173",
    "deploy:web": "npm run build:web && wrangler pages deploy mobile/dist --project-name internnotifs --branch main",
    "cloudflare:migrate:local": "wrangler d1 migrations apply intern-notifs-db --local --config wrangler.api.jsonc",
    "cloudflare:migrate:remote": "wrangler d1 migrations apply intern-notifs-db --remote --config wrangler.api.jsonc",
    "terraform:fmt": "tofu -chdir=infra/cloudflare fmt -check -recursive",
    "terraform:validate": "tofu -chdir=infra/cloudflare validate",
    "deploy:cloudflare": "npm run build:cloudflare && tsx scripts/deploy-cloudflare.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "miniflare": "5.20260820.0-alpha",
    "sharp": "0.35.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
