flowchart LR
  subgraph ING["intern-notifs-ingestion Worker"]
    C["Cron Trigger<br/>published every 30 min<br/>shadow every 3 hr"] --> D["Provider dispatcher"]
    D --> Q["Greenhouse Queue<br/>one board per message"]
    Q --> W["Queue consumer<br/>batch 1 · max concurrency 6"]
    W --> R{"Registry status"}
    R -->|shadow| S["Validate identity, schema,<br/>quality, and links"]
    R -->|published| P["Reconcile catalog<br/>and delivery state"]
    Q -->|after 2 retries| DLQ["Greenhouse DLQ"]
    W -. health and run evidence .-> O["Operations API<br/>and Worker logs"]
    DLQ -. depth .-> O
  end

  subgraph DATA["Cloudflare data plane"]
    DB[("D1<br/>catalog, checkpoints,<br/>health, and receipts")]
    PUSH["Expo push delivery"]
  end

  S --> DB
  P --> DB
  DB --> PUSH
