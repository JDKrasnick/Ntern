{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 120000,
    "subrequests": 50000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intern-notifs-dev-db",
      "database_id": "cedc86d8-69a5-4a72-a1e6-f5629d722338",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "name": "intern-notifs-dev-catalog-publisher",
  "main": "cloudflare/catalog-publisher-worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "intern-notifs-dev-documents"
    },
    {
      "binding": "SHADOW_EXTRACTION_ARTIFACTS",
      "bucket_name": "intern-notifs-dev-shadow-extraction"
    }
  ],
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "INGESTION_V2_ISOLATED_WORKERS_ENABLED": "true",
    "OUTBOUND_NOTIFICATIONS_ENABLED": "false",
    "DEPLOYMENT_ROLE": "catalog-publisher",
    "LLM_METADATA_PUBLICATION_POLICY_JSON": "{\"enabled\":true,\"version\":\"full-metadata-2026-10-v1\",\"mode\":\"prospective-provider-poll\",\"startsAt\":\"2026-10-06T04:41:00.000Z\",\"allowedFields\":[\"compensation\",\"locations\",\"workMode\",\"housing\",\"timing\",\"education\",\"eligibility\"],\"cohort\":[],\"maxReceipts\":null,\"releaseApproval\":{\"model\":\"gpt-6-luna\",\"prompt\":\"shadow-extraction-prompt-v54\",\"schema\":\"shadow-extraction-schema-v6\",\"preprocessing\":\"exact-posting-markdown-v3\",\"approvedAt\":\"2026-10-15T17:22:10.312408Z\",\"reason\":\"Isolated dev preview of compact v54 tags; production requires exact-profile approval and refreshed historical extraction.\",\"historicalCohortRoot\":\"343ebdcebef7f9cc91b0ce74d0cb9da4f27936c1a61142b2899c6e415a64e8f1\",\"historicalCohortSize\":1}}"
  },
  "queues": {
    "producers": [],
    "consumers": []
  }
}
