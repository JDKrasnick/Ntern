/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; connect-src 'self' https:; font-src 'self' data:; img-src 'self' data: blob: https://api.ntern.app https://intern-notifs.jdkrasnick.workers.dev https://intern-notifs-dev.jdkrasnick.workers.dev; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
