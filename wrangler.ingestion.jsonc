{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intern-notifs-ingestion",
  "main": "cloudflare/ingestion-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "D1_TRAFFIC_CONTROLLER", "class_name": "D1TrafficController" }] },
  "migrations": [{ "tag": "v1-d1-traffic-controller", "new_sqlite_classes": ["D1TrafficController"] }],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 120000, "subrequests": 10000 },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "intern-notifs-db", "database_id": "4e389f1c-7c6d-48e1-aa97-dc4cb1769bb8", "migrations_dir": "cloudflare/migrations" }
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "intern-notifs-documents" },
    { "binding": "SHADOW_EXTRACTION_ARTIFACTS", "bucket_name": "intern-notifs-shadow-extraction" }
  ],
  "browser": { "binding": "DESTINATION_BROWSER" },
  "queues": {
    "producers": [
      { "binding": "GREENHOUSE_QUEUE", "queue": "intern-notifs-greenhouse" },
      { "binding": "LEVER_QUEUE", "queue": "intern-notifs-lever" },
      { "binding": "ASHBY_QUEUE", "queue": "intern-notifs-ashby" },
      { "binding": "GITHUB_QUEUE", "queue": "intern-notifs-github" },
      { "binding": "GMAIL_QUEUE", "queue": "intern-notifs-gmail" },
      { "binding": "DESTINATION_VERIFICATION_QUEUE", "queue": "intern-notifs-destination-verification" },
      { "binding": "SHADOW_EXTRACTION_QUEUE", "queue": "intern-notifs-shadow-extraction" },
      { "binding": "GREENHOUSE_DLQ", "queue": "intern-notifs-greenhouse-dlq" },
      { "binding": "LEVER_DLQ", "queue": "intern-notifs-lever-dlq" },
      { "binding": "ASHBY_DLQ", "queue": "intern-notifs-ashby-dlq" },
      { "binding": "GITHUB_DLQ", "queue": "intern-notifs-github-dlq" },
      { "binding": "GMAIL_DLQ", "queue": "intern-notifs-gmail-dlq" },
      { "binding": "DESTINATION_VERIFICATION_DLQ", "queue": "intern-notifs-destination-verification-dlq" },
      { "binding": "SHADOW_EXTRACTION_DLQ", "queue": "intern-notifs-shadow-extraction-dlq" }
    ],
    "consumers": [
      { "queue": "intern-notifs-greenhouse", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 6, "dead_letter_queue": "intern-notifs-greenhouse-dlq" },
      { "queue": "intern-notifs-lever", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 2, "dead_letter_queue": "intern-notifs-lever-dlq" },
      { "queue": "intern-notifs-ashby", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 2, "dead_letter_queue": "intern-notifs-ashby-dlq" },
      { "queue": "intern-notifs-github", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 2, "dead_letter_queue": "intern-notifs-github-dlq" },
      { "queue": "intern-notifs-gmail", "max_batch_size": 1, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "intern-notifs-gmail-dlq" },
      { "queue": "intern-notifs-destination-verification", "max_batch_size": 5, "max_batch_timeout": 60, "max_concurrency": 1, "max_retries": 2, "dead_letter_queue": "intern-notifs-destination-verification-dlq" },
      { "queue": "intern-notifs-shadow-extraction", "max_batch_size": 1, "max_batch_timeout": 60, "max_concurrency": 1, "max_retries": 2, "retry_delay": 300, "dead_letter_queue": "intern-notifs-shadow-extraction-dlq" }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "7-57/10 * * * *", "9-59/10 * * * *", "12,42 * * * *", "22,52 * * * *", "2,32 * * * *", "0 * * * *", "42 8 * * *", "17 9 * * *"]
  },
  "version_metadata": { "binding": "VERSION_METADATA" },
  "vars": {
    "PUBLIC_API_URL": "https://intern-notifs.jdkrasnick.workers.dev",
    "AUTH_FROM_EMAIL": "Ntern <notifications@send.ntern.app>",
    "EMPLOYER_PORTAL_ENABLED": "true",
    "IDENTITY_UNCONFIRMED_PUBLICATION_ENABLED": "true",
    "IDENTITY_INTEGRITY_ENFORCEMENT_ENABLED": "false",
    "TRUSTED_COMMUNITY_CATALOG_ENABLED": "false",
    "IDENTITY_CONFIRMED_COVERAGE_FLOOR": "0",
    "GMAIL_ENABLED": "true",
    "RESUME_TUNER_ENABLED": "false",
    "SHADOW_EXTRACTION_ENABLED": "true",
    "SHADOW_EXTRACTION_MONTHLY_FORECAST_CENTS": "1500",
    "SHADOW_EXTRACTION_MONTHLY_HEADROOM_CENTS": "500",
    "LLM_METADATA_PUBLICATION_POLICY_JSON": "{\"enabled\":false,\"version\":\"disabled\",\"allowedFields\":[],\"cohort\":[]}",
    "ADMISSION_QUEUE_AGE_ALERT_HOURS": "120",
    "ADMISSION_STALE_ALERT_THRESHOLD": "1",
    "GMAIL_CLIENT_ID": "17433524169-4753680goh32205can9g00ijqan3hic5.apps.googleusercontent.com",
    "GMAIL_REDIRECT_URI": "https://intern-notifs.jdkrasnick.workers.dev/oauth/gmail/callback",
    "CLOUDFLARE_ACCOUNT_ID": "4d67a0f1b73641df84af0a283dd5b3d8",
    "WORKER_NAME": "intern-notifs-ingestion",
    "GREENHOUSE_QUEUE_ID": "559dc736d508485eb6590f356c12e949",
    "LEVER_QUEUE_ID": "3d3a29e9d4174887b70661e90142d1df",
    "ASHBY_QUEUE_ID": "f6b174b8a87b42408a75a2513326e265",
    "GITHUB_QUEUE_ID": "d40e2b26bf2140368fe88b10f1ef1575",
    "GMAIL_QUEUE_ID": "4fb23438b39d42faa6ca0cdc867373cc",
    "DESTINATION_VERIFICATION_QUEUE_ID": "9b48a594d06a441e8b8ed45de0c430af",
    "SHADOW_EXTRACTION_QUEUE_NAME": "intern-notifs-shadow-extraction",
    "DEPLOYMENT_ROLE": "ingestion"
  }
}
